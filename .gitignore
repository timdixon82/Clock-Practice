# Node.js development dependencies (installed locally for lint and CI checks).
# The project has no build step; node_modules is never committed.
node_modules/

# npm artefacts
npm-debug.log*
.npm

# Build output
dist/
build/

# Logs
*.log

# macOS finder artefacts
.DS_Store

# iCloud Drive sync conflict copies — created when iCloud detects a conflict.
# These are sync artefacts, never intentional, and never belong in the repo.
* 2.*
* 3.*
* 4.*
* 5.*

# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key

# Editor artefacts
.vscode/
*.swp
*.swo

# Generated at CI time by the accessibility workflow; must not be committed.
pa11y.ci.json
